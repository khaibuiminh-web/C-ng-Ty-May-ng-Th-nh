# ============================================================
#  Cấu hình email cho form liên hệ (Nodemailer)
#  Sao chép file này thành ".env" rồi điền thông tin thật.
#  Nếu để trống, form vẫn chạy ở CHẾ ĐỘ DEMO (không gửi email).
# ============================================================

# Cổng chạy server (mặc định 3000)
PORT=3000

# Thông tin SMTP — ví dụ dùng email doanh nghiệp hoặc Gmail App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email nhận thông tin liên hệ (mặc định = SMTP_USER nếu bỏ trống)
CONTACT_TO=info@dongthanh.com.vn
